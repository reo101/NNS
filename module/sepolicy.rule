# NNS scoped SELinux policy, applied by ksud at boot before any app runs.
# The root-owned launcher transitions app callers into the narrow nns_app
# domain; UID and MLS categories remain enforced by app_data_file labels.
type nns_app
typeattribute nns_app { appdomain bluetoothdomain coredomain netdomain untrusted_app_all }
# MLS-trusted subject: the store is labeled s0 while app sessions carry
# device MLS categories, and mlsconstrain unix_stream_socket connectto
# demands l1 == l2; daemon-client sockets are the only cross-level
# connection this domain makes and every access stays gated by the
# explicit allow rules below.
typeattribute nns_app mlstrustedsubject
type nns_exec { file_type exec_type system_file_type }
# Apps on older targetSdkVersions run in untrusted_app_25/_27/_32, not
# untrusted_app; the NoD app itself is targetSdk 27.
allow { untrusted_app untrusted_app_25 untrusted_app_27 untrusted_app_32 } nns_exec file { getattr open read execute map }
allow { untrusted_app untrusted_app_25 untrusted_app_27 untrusted_app_32 } nns_app process { transition siginh rlimitinh }
allow { untrusted_app untrusted_app_25 untrusted_app_27 untrusted_app_32 } nns_app process2 { nnp_transition nosuid_transition }
allow { untrusted_app untrusted_app_25 untrusted_app_27 untrusted_app_32 } nns_app process noatsecure
allow nns_app untrusted_app process sigchld
allow nns_app nns_exec file { entrypoint getattr open read execute map }
type_transition { untrusted_app untrusted_app_25 untrusted_app_27 untrusted_app_32 } nns_exec process nns_app
# Namespace setup: unshare(CLONE_NEWUSER|CLONE_NEWNS), id maps, mounts.
# SELinux checks capabilities in non-init user namespaces against the
# cap_userns class, not capability.
allow nns_app nns_app user_namespace create
allow nns_app nns_app capability { sys_admin setuid setgid }
allow nns_app nns_app cap_userns { sys_admin setuid setgid }
allow nns_app nns_app process { fork sigchld signull signal sigkill getsched setpgid }
# Private-namespace construction: make / private, mount the scratch tmpfs,
# bind the inherited tree and the store into it, then pivot_root. All of it
# happens inside the launcher's own mount namespace, which dies with the
# process; nothing outside that namespace is ever remounted.
allow nns_app fs_type filesystem { mount remount unmount pivot_root }
allow nns_app fs_type dir mounton
allow nns_app fs_type file mounton
# Scratch root and its contents live on the launcher's private tmpfs; the
# mirror re-creates the root's entries as dirs (bind-backed) and symlinks.
allow nns_app tmpfs dir { add_name create getattr open read search write remove_name rmdir mounton }
allow nns_app tmpfs file { create getattr open read write rename unlink }
allow nns_app tmpfs lnk_file { create getattr read }
allow nns_app tmpfs filesystem { mount remount unmount pivot_root }
# The scratch tmpfs is mounted on app-owned storage, and the mirror reads
# the real root: both app_data_file and rootfs objects are touched.
allow nns_app app_data_file dir mounton
allow nns_app app_data_file file mounton
allow nns_app rootfs dir { open read getattr search }
allow nns_app rootfs lnk_file { getattr read }
# Commands run inside the namespace: Android shell and dynamic linker
# (shell_exec / system_linker_exec / runtime apex) plus store contents,
# which service.sh labels system_file.
allow nns_app system_file dir { open read getattr search }
allow nns_app system_file file { getattr open read map execute execute_no_trans }
allow nns_app system_file lnk_file { getattr read }
allow nns_app shell_exec file { getattr open read map execute execute_no_trans }
allow nns_app toolbox_exec file { getattr open read map execute execute_no_trans }
allow nns_app system_linker_exec file { getattr open read map execute execute_no_trans }
allow nns_app system_linker_exec lnk_file { getattr read }
allow nns_app apex_module_file file { getattr open read map execute execute_no_trans }
# proc self-inodes (exe, fd, cwd magic links) carry the process's own SID.
allow nns_app nns_app lnk_file { read getattr create }
allow nns_app proc dir { getattr open read search }
allow nns_app proc file { getattr open read map }
allow nns_app proc lnk_file { read getattr }
allow nns_app proc_stat file { getattr open read }
# /proc/self/{uid_map,gid_map} carries the process SID.
allow nns_app nns_app dir { getattr open read search }
allow nns_app nns_app file { getattr open read write }
# Root nix daemon client: the store is root-owned and single-user nix
# locks the DB for every command, so sessions talk NIX_REMOTE=daemon to
# the root-run daemon. Socket file lives under the system_file-labeled
# store; the listening socket's kernel SID is the daemon's ksu/ksu_file
# type (ksud marks SukiSU sockets ksu_file).
allow nns_app system_file sock_file { getattr write }
allow nns_app system_file unix_stream_socket connectto
allow nns_app ksu unix_stream_socket { connectto getattr getopt read write }
allow nns_app ksu_file unix_stream_socket { connectto getattr getopt read write }
allow nns_app nns_app unix_stream_socket { connect create getattr getopt read setopt shutdown write }
# Adding a runtime type to netdomain does not regenerate compiled `self`
# socket rules. Permit ordinary client sockets explicitly for the new type.
allow nns_app nns_app { tcp_socket udp_socket } { connect create getattr getopt read setopt shutdown write }
# sshd and other in-namespace servers need these on the new type too
# (same compiled-self gap as the client sockets above).
allow nns_app nns_app tcp_socket { accept bind listen }
# Port labels: name_bind denials for app sockets are dontaudit'd, so a
# failed bind surfaces only as EACCES ("Bind to port ... Permission
# denied") with no avc line at all.
allow nns_app port_type tcp_socket name_bind
# Address side of bind(2): the port check above is dontaudit'd (silent
# EACCES), this one audits as { node_bind } tcontext=node once the port
# check passes.
allow nns_app node tcp_socket node_bind
# Scratch directory inside the app's own data dir.
allow nns_app app_data_file dir { add_name create getattr open read remove_name rename rmdir search setattr write }
# `append` for O_APPEND log files (sshd -E); `link` for nix's atomic
# tarball-cache renames.
allow nns_app app_data_file file { append create getattr link open read rename setattr unlink write map }
# nvim swap/shada locks and its IPC socket; lock was missing from both
# file and dir classes.
allow nns_app app_data_file dir lock
allow nns_app app_data_file file lock
allow nns_app nns_app unix_stream_socket { bind accept listen }
# sshd's sandbox child lowers RLIMIT_FSIZE. SELinux's task_setrlimit
# hook checks process { setrlimit } against the target's SID - a
# dontaudit'd check, so ssh_sandbox_child only ever showed a bare
# "Permission denied" with no avc line. (sys_resource is the wrong
# lever - lowering a limit never needs the capability - and stays as
# harmless belt.)
allow nns_app nns_app process setrlimit
allow nns_app nns_app capability sys_resource
# LuaJIT (nvim) maps RWX pages; without this it reports a restricted
# kernel.
allow nns_app nns_app process execmem
# Base ioctl allow so termios probes on non-tty files (scripts,
# binaries) return ENOTTY as intended instead of EACCES; WHICH ioctls
# then pass is limited by the xperm table below.
allow nns_app system_file file ioctl
# glibc >= 2.42 uses TCGETS2/TCSETS2 (0x542a/0x542b) for tcgetattr /
# tcsetattr; the platform devpts whitelist carries only the legacy
# TC* set, so isatty() failed and btop/nvim reported "no tty" while
# zsh (direct fd reads) kept working. One xperm value per line: the
# ksud parser takes exactly one.
allowxperm nns_app untrusted_app_all_devpts chr_file ioctl 0x5401
allowxperm nns_app untrusted_app_all_devpts chr_file ioctl 0x5402
allowxperm nns_app untrusted_app_all_devpts chr_file ioctl 0x5403
allowxperm nns_app untrusted_app_all_devpts chr_file ioctl 0x5404
allowxperm nns_app untrusted_app_all_devpts chr_file ioctl 0x540f
allowxperm nns_app untrusted_app_all_devpts chr_file ioctl 0x5410
allowxperm nns_app untrusted_app_all_devpts chr_file ioctl 0x5413
allowxperm nns_app untrusted_app_all_devpts chr_file ioctl 0x5414
allowxperm nns_app untrusted_app_all_devpts chr_file ioctl 0x542a
allowxperm nns_app untrusted_app_all_devpts chr_file ioctl 0x542b
allowxperm nns_app untrusted_app_all_devpts chr_file ioctl 0x542c
allowxperm nns_app untrusted_app_all_devpts chr_file ioctl 0x542d
allowxperm nns_app system_file file ioctl 0x5401
allowxperm nns_app system_file file ioctl 0x542a
# Inherited Emacs/process pipes keep the creator's SID.
allow nns_app { untrusted_app untrusted_app_25 untrusted_app_27 untrusted_app_32 } fifo_file { read write open getattr ioctl append }
