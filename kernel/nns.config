CONFIG_USER_NS=y
CONFIG_USB_CONFIGFS_F_HID=y
CONFIG_MODULE_FORCE_LOAD=y
CONFIG_LOG_BUF_SHIFT=21
CONFIG_CMDLINE="androidboot.vbmeta.device_state=unlocked androidboot.vbmeta.size=6336 androidboot.vbmeta.hash_alg=sha256 androidboot.vbmeta.digest=51a13c62771ebba4a48b6300f43342f892b225b144eb3ea12767bbdcfd7309fb androidboot.verifiedbootstate=orange"
# CONFIG_TRIM_UNUSED_KSYMS is not set
# CONFIG_UNUSED_KSYMS_WHITELIST is not set
CONFIG_KSU=y
CONFIG_KSU_FEATURE_ADBROOT=y
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_ENABLE_LOG=y
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_SUS_MAP=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_SUS_PATH=y
# CONFIG_KPM is not set
