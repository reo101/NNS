# Nix-on-Droid consumer of an independent NNS system generation.
# Sessions use the NNS launcher instead of proot, retain the app identity,
# and send store operations to the root-owned Nix daemon.
#
# Activation manages the app prefix, login, packages, terminal files, and
# Home Manager. The NoD generation profile lives in its delegated per-user
# directory. Root services and shared daemon configuration belong to NNS.
#
# Import inputs.nns.nixOnDroidModules.nns and set nns.enable = true.
# Activate the standalone NNS generation before activating NoD.

{ config, lib, options, pkgs, ... }:

let
  inherit (lib) map mkEnableOption mkForce mkIf mkOption types;
  cfg = config.nns;

  installDir = config.build.installationDir;
  generationProfile = "/nix/var/nix/profiles/per-user/${config.user.userName}/nix-on-droid";

  # su/sudo/rish ship via the module (nix/rish.nix) into
  # /data/nix/var/nns/bin and work in any nix-enter session; nothing is
  # needed NoD-side.

  # Sourced by the login shell; sets PATH (nix-on-droid-path), session
  # variables and home-manager environment from the user profile.
  loginInner = pkgs.writeScript "nns-login-inner" /* bash */ ''
    #!${pkgs.runtimeShell}

    set -eo pipefail

    # The launcher starts sessions with the raw inherited environment
    # (HOME=/ USER=root under su, or unset for apps); session-init's
    # home-manager PATH and nix.sh both interpolate $HOME while sourcing,
    # so it must be correct before anything else runs.
    export HOME="${config.user.home}"
    export USER="${config.user.userName}"

    . "${config.build.sessionInit}/etc/profile.d/nix-on-droid-session-init.sh"

    # NoD's dnshack resolver expects proot's removed /android mapping.
    # Use the NNS Bionic resolver and terminal shim for every login session.
    export LD_PRELOAD=/data/nix/lib/libnns-dns.so

    if [ "$#" -gt 0 ]; then
      exec "$@"
    fi

    exec -a "-nix-on-droid" ${config.user.shell}
  '';

  # Entry point execed by the Nix-on-Droid app. Runs on Android (bionic),
  # before any namespace exists.
  login = pkgs.writeScript "nns-login" /* bash */ ''
    #!/system/bin/sh
    # This file is generated by NNS. DO NOT EDIT.

    set -eu

    export USER="${config.user.userName}"
    export HOME="${config.user.home}"
    export NIX_REMOTE=daemon
    export NIX_CONF_DIR=/data/nix/etc/nix
    export TMPDIR="$HOME/tmp"

    # The app's session PATH may not include /system/bin (Termux-style),
    # so no PATH lookups before the launcher takes over.
    /system/bin/mkdir -p "$TMPDIR"

    exec ${cfg.launcher} --etc ${config.build.installationDir}/etc -- ${loginInner} "$@"
  '';

  # setup-etc against the app prefix instead of /etc (which is Android's own
  # and stays untouched inside launcher sessions). Same semantics as NoD's
  # setup-etc.sh, rooted at a configurable directory.
  etcScript = pkgs.writeScript "nns-setup-etc" /* bash */ ''
    #!${pkgs.runtimeShell}

    set -eu -o pipefail

    : "''${VERBOSE_ARG:=}"
    : "''${VERBOSE_ECHO:=true}"

    etc="${installDir}/etc"
    new_etc="${config.build.etc}/etc"
    backup_extension="''${1:-}"

    static="''${etc}/static"

    atomic_symlink() {
      local source="''${1}"
      local target="''${2}"
      local target_tmp="''${target}.tmp"

      $VERBOSE_ECHO "Atomic symlink ''${source} to ''${target}..."

      mkdir $VERBOSE_ARG -p "$(dirname "''${target_tmp}")"
      ln -sfn "''${source}" "''${target_tmp}"
      mv -T "''${target_tmp}" "''${target}"
    }

    is_static() {
      local path="''${1}"

      if [[ -L "''${path}" ]]; then
        [[ "$(readlink "''${path}")" == "''${static}"/* ]]
        return
      fi

      if [[ -d "''${path}" ]]; then
        local file
        for file in "''${path}"/*; do
          is_static "''${file}" || return
        done
      fi

      false
    }

    rm $VERBOSE_ARG -f "''${etc}/static"
    atomic_symlink "''${new_etc}" "''${static}"

    for name in $(find "''${new_etc}/" -type l | sed -e "s,^''${new_etc}/,," ); do
      target="''${etc}/''${name}"

      mkdir $VERBOSE_ARG -p "$(dirname "''${target}")"

      if [[ -e "''${target}" ]] && ! is_static "''${target}"; then
        if [[ -n "''${backup_extension}" ]]; then
          echo "Backing up ''${target} to ''${target}''${backup_extension}..."
          cp "''${target}" "''${target}''${backup_extension}"
          atomic_symlink "''${static}/''${name}" "''${target}"
        else
          echo "Linking of ''${target} failed. Please remove this file."
        fi
      else
        atomic_symlink "''${static}/''${name}" "''${target}"
      fi
    done
  '';

  # Package installation into the app-owned profile. The stock default
  # (per-user profiles under the root-owned profiles dir) does not fit an
  # NNS store, where apps cannot create per-user directories.
  installPackagesStep = /* bash */ ''
    if [[ -e "''${HOME}/.nix-profile/manifest.json" ]]; then
      nix_previous="$(command -v nix)"

      nix profile --profile "''${HOME}/.nix-profile" list \
        | grep 'nix-on-droid-path$' \
        | cut -d ' ' -f 4 \
        | xargs -t $DRY_RUN_CMD nix profile --profile "''${HOME}/.nix-profile" remove $VERBOSE_ARG

      $DRY_RUN_CMD $nix_previous profile --profile "''${HOME}/.nix-profile" install ${config.environment.path}

      unset nix_previous
    else
      $DRY_RUN_CMD nix-env --profile "''${HOME}/.nix-profile" --install ${config.environment.path}
    fi
  '';

  # From NoD's terminal.nix: the generated colors.properties, when the user
  # configures terminal colors.
  colorsPath =
    if config.terminal.colors != { }
    then "${pkgs.writeTextFile {
      name = "colors.properties";
      text = lib.generators.toKeyValue { } config.terminal.colors;
    }}"
    else "";

  # Same rendering as colors.properties, for the terminal settings file.
  propertiesPath =
    if config.terminal.properties != { }
    then "${pkgs.writeTextFile {
      name = "termux.properties";
      text = lib.generators.toKeyValue { } config.terminal.properties;
    }}"
    else "";

  # The terminal UI resolves these outside the namespace and ignores store
  # symlinks. Copy each file into app storage and link to that local copy.
  managedTermuxFile = { option, name, source }:
    let
      dir = "${config.user.home}/.termux";
      stored = "${dir}/nns-${name}";
      target = "${dir}/${name}";
    in
    if source != null then {
      "link${option}" = /* bash */ ''
        $DRY_RUN_CMD mkdir $VERBOSE_ARG -p "${dir}"
        if [ -e "${target}" ] && ! [ -L "${target}" ]; then
          $DRY_RUN_CMD mv $VERBOSE_ARG "${target}" "${target}.bak"
        fi
        if [ ! -e "${stored}" ]; then
          $DRY_RUN_CMD cp $VERBOSE_ARG "${source}" "${stored}"
        elif ! cmp -s "${source}" "${stored}"; then
          $DRY_RUN_CMD chmod $VERBOSE_ARG u+w "${stored}"
          $DRY_RUN_CMD cp $VERBOSE_ARG "${source}" "${stored}"
          $DRY_RUN_CMD chmod $VERBOSE_ARG u-w "${stored}"
        fi
        if [ "$(readlink "${target}")" != "${stored}" ]; then
          $DRY_RUN_CMD ln $VERBOSE_ARG -sf "${stored}" "${target}"
        fi
      '';
    } else {
      "unlink${option}" = /* bash */ ''
        if [ -L "${target}" ]; then
          if [ "$(readlink "${target}")" = "${stored}" ]; then
            $DRY_RUN_CMD rm $VERBOSE_ARG -f "${stored}"
          fi
          $DRY_RUN_CMD rm $VERBOSE_ARG "${target}"
        fi
      '';
    };
in
{
  options = {
    # Patch the completed package list, not one of its own elements.
    environment.packages = mkOption {
      type = types.listOf types.package;
      apply = packages: if !cfg.enable then packages else
        map (package:
          if lib.isDerivation package && (package.pname or (package.name or "")) == "nix-on-droid"
          then package.overrideAttrs (previous: {
            name = "nns-nix-on-droid";
            buildCommand = previous.buildCommand + ''
              substituteInPlace "$out/bin/nix-on-droid" --replace-fail \
                'PROFILE_DIRECTORY="/nix/var/nix/profiles/nix-on-droid"' \
                ${lib.escapeShellArg "PROFILE_DIRECTORY=${lib.escapeShellArg generationProfile}"}
            '';
          }) else package) packages;
    };

    nns = {
      enable = mkEnableOption ''
        NNS launcher-based sessions backed by an independent NNS system.
        NoD manages only its app environment, not root services or daemon configuration.
      '';
      launcher = mkOption {
        type = types.str;
        default = "/data/nix/bin/nix-enter";
        description = "Path to the static NNS launcher outside the store namespace.";
      };
    };

    terminal.properties = mkOption {
      type = types.lazyAttrsOf types.str;
      default = { };
      example = lib.literalExpression ''{
        fullscreen = "true";
        vibrate = "false";
        extra-keys = "[['ESC', '/', '-'], ['CTRL', 'ALT', 'TAB']]";
      }'';
      description = ''
        Settings rendered into ~/.termux/termux.properties on activation,
        following the terminal.font and terminal.colors family. Keys are
        the Termux property names; values are strings, as the properties
        format has no other types.
      '';
    };
  };

  config = mkIf cfg.enable {
    environment.sessionVariables.NIX_SSL_CERT_FILE =
      "${pkgs.cacert}/etc/ssl/certs/ca-bundle.crt";

    # These upstream activation options merge as whole attribute sets.
    build = lib.optionalAttrs (options ? build && options.build ? linkProotStatic) {
      linkProotStatic = mkForce false;
    } // {
      activationBefore = mkForce ({
        linkBinSh = /* bash */ ''
          $DRY_RUN_CMD mkdir $VERBOSE_ARG --parents ${installDir}/bin
          $DRY_RUN_CMD ln $VERBOSE_ARG --symbolic --force ${config.environment.binSh} ${installDir}/bin/.sh.tmp
          $DRY_RUN_CMD mv $VERBOSE_ARG ${installDir}/bin/.sh.tmp ${installDir}/bin/sh
        '';
        linkUsrBinEnv = /* bash */ ''
          $DRY_RUN_CMD mkdir $VERBOSE_ARG --parents ${installDir}/usr/bin
          $DRY_RUN_CMD ln $VERBOSE_ARG --symbolic --force ${config.environment.usrBinEnv} ${installDir}/usr/bin/.env.tmp
          $DRY_RUN_CMD mv $VERBOSE_ARG ${installDir}/usr/bin/.env.tmp ${installDir}/usr/bin/env
        '';
        checkNixVersions = ''
          $DRY_RUN_CMD ${pkgs.coreutils}/bin/env NIX_CONF_DIR=/data/nix/etc/nix \
            ${pkgs.runtimeShell} ${./check-nix-versions.sh} \
            ${config.nix.package}/bin/nix ${pkgs.jq}/bin/jq
        '';
      } // lib.optionalAttrs (config.home-manager.config != null && config.home-manager.useUserPackages) {
        setPriorityHomeManagerPath = /* bash */ ''
          if nix-env -q | grep '^home-manager-path$'; then
            $DRY_RUN_CMD nix-env $VERBOSE_ARG --set-flag priority 120 home-manager-path
          fi
        '';
      });

      activationAfter = mkForce ({
        linkProfile = ''
          generationDir="$(dirname "$0")"
          if [[ $generationDir =~ ^${lib.escapeRegex generationProfile}-([0-9]+)-link$ ]]; then
            $DRY_RUN_CMD nix-env --profile ${lib.escapeShellArg generationProfile} --switch-generation "''${BASH_REMATCH[1]}"
          else
            $DRY_RUN_CMD nix-env --profile ${lib.escapeShellArg generationProfile} --set "$_NOD_GENERATION_DIR"
          fi
        '';
      } // lib.optionalAttrs (config.home-manager.config != null) {
        homeManager = lib.optionalString (config.home-manager.backupFileExtension != null)
          "HOME_MANAGER_BACKUP_EXT=${lib.escapeShellArg config.home-manager.backupFileExtension} "
          + "${config.home-manager.config.home.activationPackage}/activate";
      });

      activation = mkForce ({
        installLogin = /* bash */ ''
          if ! diff ${installDir}/bin/login ${login} > /dev/null; then
            $DRY_RUN_CMD mkdir $VERBOSE_ARG --parents ${installDir}/bin
            $DRY_RUN_CMD cp $VERBOSE_ARG ${login} ${installDir}/bin/.login.tmp
            $DRY_RUN_CMD chmod $VERBOSE_ARG u+w ${installDir}/bin/.login.tmp
            $DRY_RUN_CMD mv $VERBOSE_ARG ${installDir}/bin/.login.tmp ${installDir}/bin/login
          fi
        '';
        installLoginInner = /* bash */ ''
          if (test -e ${installDir}/usr/lib/.login-inner.new && ! diff ${installDir}/usr/lib/.login-inner.new ${loginInner} > /dev/null) || \
              (! test -e ${installDir}/usr/lib/.login-inner.new && ! diff ${installDir}/usr/lib/login-inner ${loginInner} > /dev/null); then
            $DRY_RUN_CMD mkdir $VERBOSE_ARG --parents ${installDir}/usr/lib
            $DRY_RUN_CMD cp $VERBOSE_ARG ${loginInner} ${installDir}/usr/lib/.login-inner.tmp
            $DRY_RUN_CMD chmod $VERBOSE_ARG u+w ${installDir}/usr/lib/.login-inner.tmp
            $DRY_RUN_CMD mv $VERBOSE_ARG ${installDir}/usr/lib/.login-inner.tmp ${installDir}/usr/lib/.login-inner.new
          fi
        '';
        installProotStatic = "";
        setUpEtc = /* bash */ ''
          $DRY_RUN_CMD bash ${etcScript} \
            ${builtins.toString config.environment.etcBackupExtension}
        '';
        installPackages = installPackagesStep;
        createDevShm = /* bash */ ''
          $DRY_RUN_CMD mkdir $VERBOSE_ARG --parents ${installDir}/dev/shm
        '';
      } // managedTermuxFile {
        option = "Font";
        name = "font.ttf";
        source = if config.terminal.font != null then "${config.terminal.font}" else null;
      } // managedTermuxFile {
        option = "Colors";
        name = "colors.properties";
        source = if config.terminal.colors != { } then colorsPath else null;
      } // managedTermuxFile {
        option = "Properties";
        name = "termux.properties";
        source = if config.terminal.properties != { } then propertiesPath else null;
      });
    };
  };
}
