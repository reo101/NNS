# NNS delta: drop the inherited zygote seccomp filter when the root-owned
# launcher is execed, from do_execveat_common() itself rather than inside
# ksu_handle_execveat_sucompat(): susfs marks unprivileged app processes
# no_su at zygote spawn, and the no_su early-exit in exec.c skips the whole
# sucompat hook, so a check inside it never runs for the launcher. Android's
# app seccomp allowlist denies mount(2), pivot_root(2) and friends to app
# processes, and seccomp filters cannot be removed from userspace, so the
# rootless namespace launcher cannot function otherwise. Only the exact
# published entrypoint path triggers this; the nns_app SELinux domain and
# no_new_privs keep the resulting session scoped.
--- a/fs/exec.c
+++ b/fs/exec.c
@@ -1914,6 +1914,11 @@
 			void *envp, int *flags);
 extern int ksu_handle_execveat_sucompat(int *fd, struct filename **filename_ptr, void *argv,
 				void *envp, int *flags);
+extern void disable_seccomp(void);
+
+/* NNS: exact published entrypoint whose exec drops the inherited zygote
+ * seccomp filter; see the comment in do_execveat_common(). */
+static const char nns_entry_path[] = "/data/nix/bin/nix-enter";
 #endif

 static int do_execveat_common(int fd, struct filename *filename,
@@ -1928,6 +1933,21 @@
 		return PTR_ERR(filename);

 #ifdef CONFIG_KSU_SUSFS
+	/*
+	 * NNS: the zygote seccomp filter denies the syscalls a private
+	 * namespace needs (mount(2), pivot_root(2)) and survives a
+	 * user-namespace unshare; it cannot be removed from userspace.
+	 * Drop it for the exact root-owned entrypoint, before the no_su
+	 * mark can skip the sucompat hook. A failed exec leaves the
+	 * filter cleared, but the path is not writable by apps, so only
+	 * legitimate launches reach this branch.
+	 */
+	if (!strncmp(filename->name, nns_entry_path,
+		     sizeof(nns_entry_path) - 1) &&
+	    filename->name[sizeof(nns_entry_path) - 1] == '\0') {
+		pr_info("NNS: disabling seccomp for %s\n", filename->name);
+		disable_seccomp();
+	}
 	if (likely(susfs_is_current_proc_no_su()))
 		goto orig_flow;

