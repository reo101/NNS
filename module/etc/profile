# NNS session profile — sourced by shells started inside nix-enter
# canonical store first, system fallback (getprop, am, etc. still reachable)

export NIX_PROFILE=/nix/var/nix/profiles/profile
export PATH=$NIX_PROFILE/bin:/nix/var/nix/profiles/default/bin:$PATH

# per-session tmpfs, wiped on exit
export TMPDIR=/nix/tmp
export TMP=$TMPDIR

# keep HOME off the termux prefix unless overridden
if [ -z "$HOME_SET_BY_USER" ]; then
  export HOME=/data/nix/home
  mkdir -p "$HOME" 2>/dev/null || true
fi

# nix plumbing
export NIX_REMOTE=local
export NIX_STORE_DIR=/nix/store
export NIX_STATE_DIR=/nix/var/nix
export NIX_CONF_DIR=/data/nix/etc/nix
export NIX_BUILD_HOOK=

# ca bundle will come from the nix closure once seeded
if [ -f /nix/etc/ssl/certs/ca-bundle.crt ]; then
  export SSL_CERT_FILE=/nix/etc/ssl/certs/ca-bundle.crt
fi

for f in /data/nix/etc/profile.d/*.sh; do
  [ -f "$f" ] && . "$f"
done