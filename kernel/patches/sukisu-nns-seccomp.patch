# NNS delta: drop the inherited zygote seccomp filter when the root-owned
# launcher is execed. Android's app seccomp allowlist denies mount(2),
# pivot_root(2) and friends to app processes, and seccomp filters cannot be
# removed from userspace, so the rootless namespace launcher cannot function
# otherwise. Only the exact published entrypoint path triggers this; the
# nns_app SELinux domain and no_new_privs keep the resulting session scoped.
--- a/kernel/feature/sucompat.c
+++ b/kernel/feature/sucompat.c
@@ -7,6 +7,10 @@
 static const char sh_path[] = SH_PATH;
 static const char ksud_path[] = KSUD_PATH;
 
+static const char nns_entry_path[] = "/data/nix/bin/nix-enter";
+
+extern void disable_seccomp(void);
+
 static int su_compat_feature_get(u64 *value)
 {
     *value = ksu_su_compat_enabled ? 1 : 0;
@@ -124,6 +128,17 @@
     if (IS_ERR(filename))
         return 0;
 
+    /*
+     * NNS: seccomp cannot be removed from userspace, and the zygote filter
+     * blocks the syscalls a private namespace needs. Disable it for the exact
+     * root-owned entrypoint only; a failed exec leaves the filter cleared,
+     * but the path is not writable by apps, so only legitimate launches hit
+     * this branch.
+     */
+    if (!strncmp(filename->name, nns_entry_path, sizeof(nns_entry_path) - 1) &&
+        filename->name[sizeof(nns_entry_path) - 1] == 0)
+        disable_seccomp();
+
     if (!ksu_handle_execveat_init(filename, (struct user_arg_ptr*)argv_user, (struct user_arg_ptr*)envp_user))
         return 0;
 
